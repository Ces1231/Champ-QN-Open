# CHAMP-QN Crypto Readiness Scanner — environment configuration example.
# Copy to .env if using docker-compose's env_file support, or export these
# directly in your shell. No values below are secrets; none are required
# to run the application with safe defaults.

# Internal container port the app listens on. The published HOST port is
# chosen automatically by scripts/start.sh / scripts/start.ps1.
CHAMPQN_PORT=8000
CHAMPQN_HOST=0.0.0.0

# Upload safety limits.
CHAMPQN_MAX_UPLOAD_BYTES=2097152
CHAMPQN_MAX_ASSETS=2000
CHAMPQN_MAX_ALGORITHMS_PER_ASSET=200

# Persistence is OFF by default. Uploaded inventories are processed in
# memory only. This reference version does not implement a write path even
# when this flag is set to true -- it is reserved for future use and
# documented here for transparency. See SECURITY.md.
CHAMPQN_PERSIST_UPLOADS=false
CHAMPQN_PERSIST_DIR=/data

CHAMPQN_LOG_LEVEL=info
